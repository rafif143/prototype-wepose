{
  "name": "feature-based-refactor",
  "version": "1.0.0",
  "description": "Automated refactoring tool to convert type-based to feature-based architecture",
  "type": "module",
  "scripts": {
    "demo": "tsx src/cli-demo.ts",
    "demo:phase3": "tsx src/demo-phase3.ts",
    "demo:import-updater": "tsx src/demo-import-updater.ts",
    "refactor:dry-run": "tsx src/cli.ts --dry-run",
    "refactor:migrate": "tsx src/cli.ts --migrate",
    "refactor:interactive": "tsx src/cli.ts --interactive",
    "refactor:abort": "tsx src/cli.ts --abort",
    "migrate:phase3": "tsx src/migrator/phase3-orchestrator.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "refactor",
    "migration",
    "architecture"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@typescript-eslint/typescript-estree": "^8.57.0",
    "fast-check": "^4.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
